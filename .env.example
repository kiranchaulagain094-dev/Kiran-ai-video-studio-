# ============================================================================
# KIRAN AI VIDEO STUDIO - ENVIRONMENT VARIABLES
# Server-side environment variables (Do NOT prefix with VITE_ - never exposed to browser)
# ============================================================================

# 1. Neon PostgreSQL Database URL (Configured in Vercel)
# Format: postgresql://[user]:[password]@[neon-hostname]/neondb?sslmode=require
DATABASE_URL=

# 2. Application Base URL (e.g., https://your-domain.vercel.app or http://localhost:3000)
APP_URL=

# 3. Google OAuth 2.0 Credentials (From Google Cloud Console: APIs & Services > Credentials)
# Authorized redirect URI: [APP_URL]/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 4. Session Secret (Random 32+ character string for HMAC signing session tokens)
SESSION_SECRET=

# 5. Google Gemini AI API Key
GEMINI_API_KEY=

# 6. Admin Secret Key (Optional)
ADMIN_SECRET_KEY=

# 7. Resend Transactional Email API (https://resend.com/api-keys)
RESEND_API_KEY=

# 8. Admin Notification Recipient (Defaults to Kiranchaulagain094@gmail.com)
ADMIN_NOTIFICATION_EMAIL=Kiranchaulagain094@gmail.com

# 9. Verified Sender Address (Use onboarding@resend.dev for test or your verified domain)
EMAIL_FROM_ADDRESS=Kiran AI Video Studio <onboarding@resend.dev>

# 10. Google reCAPTCHA v2 / v3 Credentials (Optional abuse protection)
# Server-side verification secret (Never exposed to browser):
RECAPTCHA_SECRET_KEY=
# Client-side site key (Exposed to browser via Vite prefix):
VITE_RECAPTCHA_SITE_KEY=

