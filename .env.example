# Server-side environment variables (Do NOT prefix with VITE_ - never exposed to browser)
# PostgreSQL Database URL for permanent cloud storage (Neon, Supabase, AWS RDS Aurora)
DATABASE_URL=postgresql://username:password@ep-sample-pooler.region.neon.tech/neondb?sslmode=require

# Gemini API Key for AI Director, screenplay planning, script generation, and SEO
GEMINI_API_KEY=

# Application & Session Secrets
APP_URL=
ADMIN_SECRET_KEY=
SESSION_SECRET=
